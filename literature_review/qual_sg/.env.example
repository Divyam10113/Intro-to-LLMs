# QUAL-SG configuration.  Copy to `.env` and fill in what you need.

# --- LLM provider (Groq; strongest open-weights models, free tier) -----------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Stage models (open-weights on Groq). Default: openai/gpt-oss-120b.
# QUAL_SG_JUDGE_MODEL=openai/gpt-oss-120b
# QUAL_SG_OUTLINE_MODEL=openai/gpt-oss-120b
# QUAL_SG_WRITER_MODEL=openai/gpt-oss-120b
# QUAL_SG_EVAL_MODEL=openai/gpt-oss-120b
# QUAL_SG_MODEL_FALLBACKS=llama-3.3-70b-versatile,openai/gpt-oss-20b

# --- Free-tier quotas --------------------------------------------------------
# QUAL_SG_RPM=28              # requests per minute allowed by the provider
# QUAL_SG_CONCURRENCY=3

# --- Pipeline knobs ----------------------------------------------------------
# QUAL_SG_CANDIDATE_POOL=300
# QUAL_SG_COCITATION_MIN=2
# QUAL_SG_COCITATION_TOPN=50
# QUAL_SG_TOPIC_CSV=example/topic.csv
# QUAL_SG_FORCE=1             # redo steps whose output already exists

# --- Literature APIs ---------------------------------------------------------
# QUAL_SG_MAILTO=you@example.com   # OpenAlex polite pool
# SEMANTIC_SCHOLAR_API_KEY=
# QUAL_SG_USE_S2=1                 # try Semantic Scholar before OpenAlex

# --- Evaluation --------------------------------------------------------------
# QUAL_SG_GOLD_JSON=example/Gold_Standard_....json
# QUAL_SG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
