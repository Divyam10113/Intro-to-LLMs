# Copy to .env (git-ignored) and fill in only what you need. The environment wins over .env,
# and .env wins over the defaults in shared/config.sh / shared/config.py.
# Never commit .env or any key.

# ---------------------------------------------------------------- paths (defaults = course server)
# PROJ_ROOT=..                                  # folder that holds this repo (default: its parent)
# MVFA_DIR=$PROJ_ROOT/MVFA-AD                   # MVFA-AD checkout, commit a30bf7b (Task 4)
# TASK4_PYTHON=$PROJ_ROOT/.venv-task4/bin/python  # Python with torch + pytest (Task 4, and smoke runs)
# TASK4_HDD=/mnt/HDD1/divyam/task4              # Task 4 data, checkpoints, round 1 runs
# TASK4R2_HDD=/mnt/HDD1/divyam/task4/r2         # round 2 runs and normal banks
# TASK4R3_HDD=/mnt/HDD1/divyam/task4/r3         # round 3 runs (the follow-up's scripts default to .../fu)
# TASK4_DL_TMP=$PROJ_ROOT/.dl_tmp               # scratch for task4_weak_supervision/download_data.sh
# PYTHON=python3                                # Python for Tasks 0-3 (make PYTHON=...)

# ---------------------------------------------------------------- Task 0 (course starter)
# AGENTROUTER_API_KEY=                          # generate_review.py only

# ---------------------------------------------------------------- Task 1 (QUAL-SG); see task1_literature_review/qual_sg/.env.example
# OPENALEX_API_KEY=
# GROQ_API_KEY=                                 # only with QUAL_SG_BACKEND=openai (run v6 used the file backend)

# ---------------------------------------------------------------- Task 2 (limitations)
# LLM_PROVIDER=nim                              # nim (main run, outputs/full_nim) or agentrouter
# NVIDIA_API_KEY=
# AGENTROUTER_API_KEY=

# ---------------------------------------------------------------- Task 3 (ideation); default backend "file" replays logs/cache, no key
# LLM_BACKEND=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=
# JUDGE_BACKEND= JUDGE_BASE_URL= JUDGE_MODEL= JUDGE_API_KEY=

# ---------------------------------------------------------------- Task 5 (paper); make task5 needs no key
# Only to regenerate the text with PaperOrchestra (paid calls; not part of make task5):
# GEMINI_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=                     # optional, literature agent
# TECTONIC=                                     # optional: Tectonic binary for make task5-dry-run without pdflatex
